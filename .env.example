# ---------------------------------------------------------------------------
# MEDICs POS prototype - environment template
# Copy to .env and fill in. ALL VALUES ARE INTENTIONALLY BLANK.
#
# The current prototype runs with ZERO environment variables: every screen is
# driven by mock data in src/data.js. Everything below is optional and only
# becomes relevant once the app is wired to a real backend.
# Never commit a filled-in .env file.
# ---------------------------------------------------------------------------

# --- Frontend (Vite: only VITE_* vars are exposed to the browser) ---
VITE_APP_ENV=
VITE_API_BASE_URL=
VITE_BRANCH_ID=
VITE_TERMINAL_ID=
VITE_ENABLE_MOCK_DATA=

# --- Backend / database (only if a real API is added) ---
# DATABASE_URL=
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Auth (only if real login replaces the prototype's pass-through) ---
# JWT_SECRET=
# JWT_EXPIRES_IN=
# SESSION_SECRET=

# --- Devices / Medics Mobile bridge (invoice scanning feature) ---
# PHONE_BRIDGE_URL=
# PHONE_BRIDGE_TIMEOUT_MS=
